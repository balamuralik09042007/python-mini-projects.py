print("===weight converter===")
weight=float(input("enter the weight:"))
unit=input("enter the kgs or lbs(k or l):")

if unit == "k":
    kgs=weight/2.203
    print(f"the weight in kgs{weight} in {kgs}")
elif unit =="l":
    lbs=weight*2.203
    print(f"the weight in lbs{weight} in {lbs}")
else:
    print("invalid number")
